# ============================================================
# SHAHEEN AI
# Open WebUI based self-hosted AI deployment
# ============================================================

WEBUI_URL=https://shaheen-group.mooo.com
WEBUI_NAME=SHAHEEN AI
WEBUI_SECRET_KEY=CHANGE_ME
ENV=prod

# ------------------------------------------------------------
# Ollama
# ------------------------------------------------------------

OLLAMA_BASE_URL=http://host.docker.internal:11434

# ------------------------------------------------------------
# AI Providers
# Leave empty unless you intentionally configure the provider.
# ------------------------------------------------------------

OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.openai.com/v1

OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=

# ------------------------------------------------------------
# Web Search
# ------------------------------------------------------------

ENABLE_WEB_SEARCH=true
WEB_SEARCH_ENGINE=tavily
WEB_SEARCH_RESULT_COUNT=5
WEB_SEARCH_CONCURRENT_REQUESTS=2

TAVILY_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=
GOOGLE_PSE_API_KEY=
GOOGLE_PSE_ENGINE_ID=

FIRECRAWL_API_BASE_URL=https://api.firecrawl.dev

# ------------------------------------------------------------
# API
# ------------------------------------------------------------

ENABLE_API_KEYS=true

# ------------------------------------------------------------
# Security / CORS
# ------------------------------------------------------------

CORS_ALLOW_ORIGIN=https://shaheen-group.mooo.com

WEBUI_SESSION_COOKIE_SECURE=true
WEBUI_AUTH_COOKIE_SECURE=true

WEBUI_SESSION_COOKIE_SAME_SITE=lax
WEBUI_AUTH_COOKIE_SAME_SITE=lax

# ------------------------------------------------------------
# PWA
# ------------------------------------------------------------

EXTERNAL_PWA_MANIFEST_URL=https://shaheen-group.mooo.com/manifest.json

# SHAHEEN AI product configuration
SHAHEEN_AI_NAME=SHAHEEN AI
SHAHEEN_AI_DOMAIN=shaheen-group.mooo.com
SHAHEEN_AI_URL=https://shaheen-group.mooo.com
