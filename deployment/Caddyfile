shaheen-group.mooo.com {
    handle /shaheen-ai/* {
        root * /var/www
        file_server
    }

    handle {
        reverse_proxy 127.0.0.1:3000
    }

    encode gzip zstd

    header {
        -Server
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Frame-Options "SAMEORIGIN"
    }
}
